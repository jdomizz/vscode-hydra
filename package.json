{
  "name": "vscode-hydra",
  "version": "0.4.0",
  "displayName": "Hydra Code",
  "description": "Live coding with Hydra in Visual Studio Code",
  "publisher": "jdomizz",
  "license": "AGPL-3.0-or-later",
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vscode-hydra.evalDocument",
        "title": "Eval document with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.evalLine",
        "title": "Eval line or selection with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.evalBlock",
        "title": "Eval block with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.captureImage",
        "title": "Take screenshot",
        "category": "Hydra",
        "icon": "$(device-camera)"
      },
      {
        "command": "vscode-hydra.startRecorder",
        "title": "Start video recording",
        "category": "Hydra",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "vscode-hydra.stopRecorder",
        "title": "Stop video recording",
        "category": "Hydra",
        "icon": "$(circle-large-filled)"
      },
      {
        "command": "hydra.startOscBridge",
        "title": "Start OSC Bridge",
        "category": "Hydra"
      },
      {
        "command": "hydra.stopOscBridge",
        "title": "Stop OSC Bridge",
        "category": "Hydra"
      },
      {
        "command": "hydra.startHttpServer",
        "title": "Start HTTP Server",
        "category": "Hydra"
      },
      {
        "command": "hydra.stopHttpServer",
        "title": "Stop HTTP Server",
        "category": "Hydra"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-hydra.evalDocument",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.evalLine",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.evalBlock",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.captureImage",
        "key": "ctrl+shift+S",
        "mac": "cmd+shift+S",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.startRecorder",
        "key": "ctrl+shift+V",
        "mac": "cmd+shift+V",
        "when": "resourceLangId == javascript && vscode-hydra.status == 'rendering'"
      },
      {
        "command": "vscode-hydra.stopRecorder",
        "key": "ctrl+shift+V",
        "mac": "cmd+shift+V",
        "when": "resourceLangId == javascript && vscode-hydra.status == 'recording'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-hydra.evalDocument",
          "group": "navigation",
          "when": "resourceLangId == javascript"
        }
      ]
    },
    "configuration": {
      "title": "Hydra",
      "properties": {
        "hydra.connectToSweep": {
          "type": "boolean",
          "default": false,
          "description": "Connect to Sweep PWA for full-featured live coding (MIDI, cameras, output window)"
        },
        "hydra.sweepCliPath": {
          "type": "string",
          "default": "sweepctl",
          "description": "Path to sweepctl executable"
        },
        "hydra.syncPort": {
          "type": "number",
          "default": 9163,
          "description": "Port for sweep-sync WebSocket server"
        },
        "hydra.canvasUrl": {
          "type": "string",
          "default": "http://localhost:4173/canvas.html",
          "description": "URL of Sweep canvas.html entry point"
        },
        "hydra.oscBridgePath": {
          "type": "string",
          "default": "sweep-osc-bridge",
          "description": "Path to sweep-osc-bridge executable"
        },
        "hydra.oscUdpPort": {
          "type": "number",
          "default": 9000,
          "description": "UDP port for OSC bridge"
        },
        "hydra.httpServerPath": {
          "type": "string",
          "default": "sweep-http",
          "description": "Path to sweep-http executable"
        },
        "hydra.httpPort": {
          "type": "number",
          "default": 8080,
          "description": "Port for HTTP server"
        },
        "hydra.httpRoot": {
          "type": "string",
          "default": "",
          "description": "Root directory for HTTP server (empty = workspace folder)"
        },
        "hydra.autoStartOscBridge": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start OSC bridge on activation"
        },
        "hydra.autoStartHttpServer": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start HTTP server on activation"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:backend && npm run compile:runtime",
    "compile:backend": "tsc",
    "compile:runtime": "node -e \"require('node:fs').mkdirSync('out/runtime',{recursive:true});require('node:fs').copyFileSync('src/runtime/index.html','out/runtime/index.html')\" && rollup -c",
    "watch": "tsc -watch",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:osc": "node demo/osc-node.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@jdomizz/rig-host": "file:../rig/packages/rig-host",
    "@jdomizz/rig-transport": "file:../rig/packages/rig-transport",
    "hydra-element": "file:../hydra-element",
    "open": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.88.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.57.0",
    "node-osc": "^9.1.1",
    "osc-js": "^2.4.1",
    "ovsx": "^0.10.12",
    "rollup": "^4.60.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/vscode-hydra.git"
  },
  "homepage": "https://github.com/jdomizz/vscode-hydra#readme",
  "qna": "https://github.com/jdomizz/vscode-hydra/discussions",
  "bugs": "https://github.com/jdomizz/vscode-hydra/issues",
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "creative-coding",
    "livecoding",
    "hydra-synth",
    "p5js",
    "osc"
  ]
}
