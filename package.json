{
  "name": "vscode-hydra",
  "version": "0.4.0",
  "displayName": "Hydra Code",
  "description": "Live coding with Hydra in Visual Studio Code",
  "publisher": "jdomizz",
  "license": "AGPL-3.0-or-later",
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vscode-hydra.evalDocument",
        "title": "Eval document with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.evalLine",
        "title": "Eval line or selection with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.evalBlock",
        "title": "Eval block with Hydra",
        "category": "Hydra",
        "icon": "$(play)"
      },
      {
        "command": "vscode-hydra.captureImage",
        "title": "Take screenshot",
        "category": "Hydra",
        "icon": "$(device-camera)"
      },
      {
        "command": "vscode-hydra.startRecorder",
        "title": "Start video recording",
        "category": "Hydra",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "vscode-hydra.stopRecorder",
        "title": "Stop video recording",
        "category": "Hydra",
        "icon": "$(circle-large-filled)"
      },
      {
        "command": "vscode-hydra.openRuntime",
        "title": "Open runtime in browser",
        "category": "Hydra"
      },
      {
        "command": "vscode-hydra.panic",
        "title": "Panic — silence all outputs",
        "category": "Hydra"
      },
      {
        "command": "hydra.startOscBridge",
        "title": "[deprecated] Start OSC bridge — use rig.* instead",
        "category": "Hydra"
      },
      {
        "command": "hydra.stopOscBridge",
        "title": "[deprecated] Stop OSC bridge — use rig.* instead",
        "category": "Hydra"
      },
      {
        "command": "hydra.startHttpServer",
        "title": "[deprecated] Start HTTP server — use rig.* instead",
        "category": "Hydra"
      },
      {
        "command": "hydra.stopHttpServer",
        "title": "[deprecated] Stop HTTP server — use rig.* instead",
        "category": "Hydra"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-hydra.evalDocument",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.evalLine",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.evalBlock",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.captureImage",
        "key": "ctrl+shift+S",
        "mac": "cmd+shift+S",
        "when": "resourceLangId == javascript"
      },
      {
        "command": "vscode-hydra.startRecorder",
        "key": "ctrl+shift+V",
        "mac": "cmd+shift+V",
        "when": "resourceLangId == javascript && vscode-hydra.status == 'rendering'"
      },
      {
        "command": "vscode-hydra.stopRecorder",
        "key": "ctrl+shift+V",
        "mac": "cmd+shift+V",
        "when": "resourceLangId == javascript && vscode-hydra.status == 'recording'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-hydra.evalDocument",
          "group": "navigation",
          "when": "resourceLangId == javascript"
        },
        {
          "command": "vscode-hydra.captureImage",
          "group": "navigation",
          "when": "resourceLangId == javascript && vscode-hydra.status == 'rendering'"
        },
        {
          "command": "vscode-hydra.startRecorder",
          "group": "navigation",
          "when": "resourceLangId == javascript && vscode-hydra.status == 'rendering'"
        },
        {
          "command": "vscode-hydra.stopRecorder",
          "group": "navigation",
          "when": "resourceLangId == javascript && vscode-hydra.status == 'recording'"
        }
      ]
    },
    "configuration": {
      "title": "Hydra",
      "properties": {
        "rig.instrument": {
          "type": "string",
          "default": "sweep",
          "enum": ["sweep", "cycles"],
          "description": "Instrument (sweep or future cycles)"
        },
        "rig.target": {
          "type": "string",
          "default": "default",
          "enum": ["sweep", "hydra", "default"],
          "description": "Runtime profile → ?context= URL param"
        },
        "rig.renderer": {
          "type": "string",
          "default": "external",
          "enum": ["external", "webview"],
          "description": "Renderer surface. `external` opens the served runtime page in your browser (only surface with camera/audio/MIDI). `webview` is reserved for future contained mounts; v1.0 falls back to `external` with an info message."
        },
        "rig.relayPort": {
          "type": "number",
          "default": 9163,
          "description": "WebSocket relay port"
        },
        "rig.httpPort": {
          "type": "number",
          "default": 8080,
          "description": "HTTP server port (serves runtime page + workspace assets)"
        },
        "rig.udpIn": {
          "type": "number",
          "default": 9000,
          "description": "OSC UDP in port"
        },
        "rig.udpOut": {
          "type": "number",
          "default": 9001,
          "description": "OSC UDP out port"
        },
        "rig.midiEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MIDI bridge"
        },
        "rig.sweepCliPath": {
          "type": "string",
          "default": "sweepctl",
          "description": "Path to sweepctl executable"
        },
        "rig.oscBridgePath": {
          "type": "string",
          "default": "sweep-osc-bridge",
          "description": "Path to OSC bridge binary"
        },
        "rig.midiBridgePath": {
          "type": "string",
          "default": "sweep-midi-bridge",
          "description": "Path to MIDI bridge binary"
        },
        "rig.httpServerPath": {
          "type": "string",
          "default": "sweep-http",
          "description": "Path to HTTP server binary"
        },
        "rig.relayPath": {
          "type": "string",
          "default": "rig-relay",
          "description": "Path to external relay binary (hybrid mode)"
        },
        "rig.servePath": {
          "type": "string",
          "default": "rig-serve",
          "description": "Path to external serve binary (hybrid mode)"
        },
        "rig.loadScripts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "JavaScript URLs to load on runtime ready (extensions, libraries)"
        },
        "rig.capturePort": {
          "type": "number",
          "default": 8081,
          "description": "HTTP port for capture blob receiver (PNG/WebM upload from runtime)"
        },
        "rig.captureTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in ms for capture blob HTTP POST"
        },
        "hydra.sweepCliPath": {
          "type": "string",
          "default": "sweepctl",
          "description": "(Legacy fallback for rig.sweepCliPath)"
        },
        "hydra.syncPort": {
          "type": "number",
          "default": 9163,
          "description": "(Legacy fallback for rig.relayPort)"
        },
        "hydra.oscBridgePath": {
          "type": "string",
          "default": "sweep-osc-bridge",
          "description": "(Legacy fallback for rig.oscBridgePath)"
        },
        "hydra.oscUdpPort": {
          "type": "number",
          "default": 9000,
          "description": "(Legacy fallback for rig.udpIn)"
        },
        "hydra.httpServerPath": {
          "type": "string",
          "default": "sweep-http",
          "description": "(Legacy fallback for rig.httpServerPath)"
        },
        "hydra.httpPort": {
          "type": "number",
          "default": 8080,
          "description": "(Legacy fallback for rig.httpPort)"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:backend && npm run compile:runtime",
    "compile:backend": "tsc",
    "compile:runtime": "node -e \"require('node:fs').mkdirSync('out/runtime',{recursive:true});require('node:fs').copyFileSync('src/runtime/index.html','out/runtime/index.html')\" && rollup -c",
    "watch": "tsc -watch",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:osc": "node demo/osc-node.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@jdomizz/rig-host": "file:../rig/packages/rig-host",
    "@jdomizz/rig-relay": "file:../rig/packages/rig-relay",
    "@jdomizz/rig-serve": "file:../rig/packages/rig-serve",
    "@jdomizz/rig-transport": "file:../rig/packages/rig-transport",
    "hydra-element": "file:../hydra-element",
    "open": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.88.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.57.0",
    "node-osc": "^9.1.1",
    "osc-js": "^2.4.1",
    "ovsx": "^0.10.12",
    "rollup": "^4.60.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/vscode-hydra.git"
  },
  "homepage": "https://github.com/jdomizz/vscode-hydra#readme",
  "qna": "https://github.com/jdomizz/vscode-hydra/discussions",
  "bugs": "https://github.com/jdomizz/vscode-hydra/issues",
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "creative-coding",
    "livecoding",
    "hydra-synth",
    "p5js",
    "osc"
  ]
}
