{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"vscode",
			"./src/types/hydra-synth"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"out",
		"src/**/*.spec.ts",
		"src/__mocks__/**"
	]
}
